DOMAIN=ads.papin-free.site
PUBLIC_URL=https://ads.papin-free.site
TelegramAds_API_Token=
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
SESSION_SECRET=
DATA_DIR=/data
SYNC_INTERVAL_SECONDS=300
MAX_BATCH_SIZE=50
MAX_BATCH_BUDGET=200
COOKIE_SECURE=true
RUN_WORKER=true

# Optional Telegram user account for public search/recommendations.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_PATH=/data/telegram
DISCOVERY_CACHE_SECONDS=21600
